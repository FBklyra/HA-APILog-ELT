# ALELT hub image (hub-api, worker, migrate). Build context = repo root.
#   docker build -f deploy/hub/Dockerfile.hub -t alelt/hub:<ver> .
# Entrypoints are set by docker-compose (ALELT_API_CMD / ALELT_WORKER_CMD / ALELT_MIGRATE_CMD).
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY hub/ hub/
COPY connectors/ connectors/
COPY config/ config/
# Same hashed lock as the product image (DEP-04): no unpinned resolver run at build time.
COPY deploy/image/requirements.lock /tmp/requirements.lock
RUN python -m venv /opt/alelt \
 && /opt/alelt/bin/pip install --require-hashes --no-deps --only-binary=:all: -r /tmp/requirements.lock \
 && /opt/alelt/bin/pip check
# Optional native Db2 decoder (connectors/sources/db2/decoder, CMake) when the sources are present.
RUN if [ -f connectors/sources/db2/decoder/CMakeLists.txt ]; then \
      cmake -S connectors/sources/db2/decoder -B /tmp/dec -DCMAKE_BUILD_TYPE=Release \
      && cmake --build /tmp/dec -j \
      && cmake --install /tmp/dec --prefix /opt/alelt; fi

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
LABEL org.opencontainers.image.title="alelt-hub" \
      org.opencontainers.image.authors="Freddy Beltran"
ENV PATH=/opt/alelt/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/hub:/app LD_LIBRARY_PATH=/opt/alelt/lib
RUN useradd --system --uid 10001 --home /app alelt \
 && mkdir -p /var/lib/alelt/spool && chown alelt /var/lib/alelt/spool
COPY --from=build /opt/alelt /opt/alelt
COPY --from=build /src /app
WORKDIR /app
USER alelt
EXPOSE 8080
CMD ["uvicorn", "alelt_hub.app:app", "--host", "0.0.0.0", "--port", "8080"]
