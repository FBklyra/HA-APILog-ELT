# ALELT quick start (SQLite metadata). Optional: copy to .env to override the defaults below.
ALELT_IMAGE=ghcr.io/fbklyra/ha-apilog-elt:1.0.0
ALELT_HTTP_PORT=8080
ALELT_BIND=127.0.0.1
# Local evaluation only: dev auth (role picker in the console). Never expose this on a network.
ALELT_ENV=local
ALELT_DEV_AUTH=1
# Destination (optional for a first look): a PostgreSQL database reachable from the container
# ALELT_DEST_URL=postgresql://user:password@host.docker.internal:5432/alelt_landing
# Agent token(s), comma-separated. Generate: python -c "import secrets; print(secrets.token_hex(24))"
ALELT_AGENT_TOKENS=change-me-generate-with-python-secrets-token-hex-24
