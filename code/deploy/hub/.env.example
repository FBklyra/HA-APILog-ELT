# ALELT hub - copy to .env (no secrets here; secrets live in Azure Key Vault -> /etc/alelt/secrets).
ALELT_ENV=prod
ALELT_VERSION=0.1.0
ALELT_REGISTRY=alelt
ALELT_WORKERS=4
ALELT_CONSOLE_HOST=alelt.example.internal

# Disks (Azure managed data disks, mounted by runbooks/install-hub.md)
ALELT_PG_DISK=/data/pg
ALELT_SPOOL_DISK=/data/spool
ALELT_BACKUP_DISK=/data/backup
ALELT_TLS_DIR=/etc/alelt/tls
ALELT_SECRETS_DIR=/etc/alelt/secrets

# Metadata DB
ALELT_DB_NAME=alelt
ALELT_DB_USER=alelt_hub

# Spool / gateway
ALELT_SPOOL_CAPACITY_BYTES=536870912000
ALELT_MAX_BODY_BYTES=67108864
# Comma-separated SHA-1 thumbprints of allowed agent client certs
ALELT_AGENT_THUMBPRINTS=
# Output profile: alelt (_ALELT_SYNCED/_ALELT_DELETED) or golden_spec (system columns from the golden spec of the existing landing schema)
ALELT_OUTPUT_PROFILE=alelt

# Entra ID (console SSO) - IDs are not secrets
ALELT_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
ALELT_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
ALELT_OIDC_AUDIENCE=api://alelt-hub
# group-object-id=Role pairs
ALELT_ROLE_GROUPS=<grp-oid>=Viewer,<grp-oid>=DataOperator,<grp-oid>=PlatformAdmin,<grp-oid>=Auditor

# Destination (key-pair auth; private key comes from Key Vault)
ALELT_DEST_ENGINE=snowflake
ALELT_DEST_ACCOUNT=<org>-<account>
ALELT_DEST_USER=ALELT_LOADER_SVC
ALELT_DEST_ROLE=ALELT_LOADER
ALELT_DEST_WAREHOUSE=ALELT_WH
ALELT_DEST_DATABASE=<database>

# Backups
ALELT_BACKUP_KEEP_DAYS=14
ALELT_BACKUP_AT=02:30
# Off-site copy (azcopy with VM managed identity), container URL without SAS
ALELT_BACKUP_BLOB_URL=https://<storageaccount>.blob.core.windows.net/alelt-backup

# Key Vault (secrets/fetch-secrets.sh)
ALELT_KEYVAULT_NAME=<kv-name>

# Entrypoint overrides (hub stream may change module names)
# ALELT_API_CMD=uvicorn alelt_hub.app:app --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips=*
# ALELT_WORKER_CMD=python -m alelt_hub.worker --queues decode,load,snapshot,verify
# ALELT_MIGRATE_CMD=python -m alelt_hub.migrate upgrade head

# DEP-24: group that may read the 0440 secret files (containers join it via group_add)
ALELT_SECRETS_GID=10001
# DEP-26: node-exporter textfile dir for the CRL-expiry metric (empty = off)
ALELT_NODE_TEXTFILE_DIR=
