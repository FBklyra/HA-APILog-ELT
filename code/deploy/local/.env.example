# ALELT install settings. Copy to .env and edit. Never commit .env (it holds secrets).
# Secrets may also come from files: any ALELT_<NAME>_FILE=/run/secrets/x is read into ALELT_<NAME> at start (Docker secrets).

# --- image ------------------------------------------------------------------------------------------------------
ALELT_IMAGE=alelt:local
ALELT_VERSION=0.1.0
ALELT_HTTP_PORT=8080

# --- metadata database ------------------------------------------------------------------------------------------
# postgres = bundled Postgres service (default, docker-compose.yml)
# sqlite   = quick start, single host (docker compose -f docker-compose.sqlite.yml up -d)
# external = any managed / on-prem Postgres: set ALELT_DB_URL below
ALELT_METADATA=postgres
POSTGRES_USER=alelt
POSTGRES_PASSWORD=change-me-local-only
ALELT_DB_NAME=alelt
ALELT_PG_HOST_PORT=55432
# ALELT_DB_URL=postgresql+psycopg://user:password@db.example.internal:5432/alelt

# --- destination (local install: database alelt_landing in the bundled Postgres) -----------------------------------
ALELT_LANDING_DB=alelt_landing
# ALELT_DEST_URL=postgresql://user:password@host:5432/alelt_landing
# Snowflake: ALELT_SNOWFLAKE_ACCOUNT / USER / DATABASE (+ ROLE, WAREHOUSE) and a key file mounted as a secret:
# ALELT_SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8

# --- authentication -----------------------------------------------------------------------------------------------
# Local evaluation: dev auth (role picker in the console). Production: ALELT_DEV_AUTH=0, ALELT_ENV=prod and OIDC settings.
ALELT_ENV=local
ALELT_DEV_AUTH=1
# ALELT_OIDC_ISSUER=https://idp.example.com/
# ALELT_OIDC_AUDIENCE=api://alelt
# ALELT_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# --- agents -------------------------------------------------------------------------------------------------------
# Static agent token(s), comma-separated. Generate: python -c "import secrets; print(secrets.token_hex(24))"
# Or enroll agents from the console setup wizard (one-time token bound to one connection).
ALELT_AGENT_AUTH=token
ALELT_AGENT_TOKENS=change-me-agent-token

ALELT_LOAD_MAX_LATENCY_S=0
ALELT_LOG_LEVEL=INFO

# Host interface for the published ports (DEP-10). Default 127.0.0.1: with ALELT_DEV_AUTH=1 anyone who reaches the
# API is PlatformAdmin. Set 0.0.0.0 only on an isolated host and with ALELT_DEV_AUTH=0 + OIDC.
ALELT_BIND=127.0.0.1
