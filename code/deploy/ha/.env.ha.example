# ALELT HA install settings. Copy to .env and edit. Never commit .env.
# Prefer secrets as files (docker-compose.ha.secrets.yml): ALELT_<NAME>_FILE=/run/secrets/<x>.
# Guide: ../HA.md

ALELT_IMAGE=alelt:local
ALELT_HTTP_PORT=8080
ALELT_ENV=prod
ALELT_DEV_AUTH=0

# --- metadata: Postgres HA (managed service, Patroni, ...). SQLite is NOT allowed in HA. -------------------------
# production: ./secrets/alelt_db_url via docker-compose.ha.secrets.yml (DEP-12); a value here is for rehearsals only
ALELT_DB_URL=
# demo profile (bundled Postgres): ALELT_DB_URL=postgresql+psycopg://alelt:<POSTGRES_PASSWORD>@postgres:5432/alelt

# --- destination ----------------------------------------------------------------------------------------------
# ALELT_DEST_URL=postgresql://user:password@host:5432/alelt_landing
# ALELT_DESTINATION=alelt_dst_snowflake.connector:SnowflakeDestination
# ALELT_SNOWFLAKE_ACCOUNT= / ALELT_SNOWFLAKE_USER= / ALELT_SNOWFLAKE_DATABASE= / ALELT_SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8

# --- spool: S3-compatible blob store (shared by every replica) ------------------------------------------------
ALELT_SPOOL_URL=s3://alelt-spool/prod
# empty endpoint = AWS regional endpoint; MinIO / Ceph / GCS interop: set the endpoint (path-style by default)
ALELT_S3_ENDPOINT=https://minio.example.internal:9000
ALELT_S3_REGION=us-east-1
# ALELT_S3_ADDRESSING=path|virtual
# production: files via docker-compose.ha.secrets.yml (./secrets/alelt_s3_*), not values here (DEP-12)
ALELT_S3_ACCESS_KEY_ID=
ALELT_S3_SECRET_ACCESS_KEY=
# demo profile (bundled SeaweedFS S3): ALELT_S3_ENDPOINT=http://s3:9000  ALELT_SPOOL_URL=s3://alelt-spool/demo
#   ALELT_S3_ACCESS_KEY_ID=aleltdemo ALELT_S3_SECRET_ACCESS_KEY=<choose one>   (no default demo passwords, DEP-14)
#   POSTGRES_PASSWORD=<choose one>   ALELT_LB_STATS_PASSWORD=<choose one>   ALELT_LB_BIND=127.0.0.1 (LB published on loopback)

# --- agents ---------------------------------------------------------------------------------------------------
ALELT_AGENT_AUTH=mtls
ALELT_AGENT_THUMBPRINTS=
# address(es) of the TLS terminator that verifies agent certificates (lb/haproxy-mtls.cfg); never '*'
ALELT_TRUSTED_PROXIES=
ALELT_PUBLIC_URL=https://agent.alelt.example.internal
# no static shared tokens in production (refused when ALELT_ENV=prod): enrolment tokens -> per-agent credentials
# ALELT_AGENT_AUTH=enrollment
# DBA-owned archive-log retention (hours) for the archive-horizon alert (X-129); JSON for per-connection values
ALELT_ARCHIVE_RETENTION_HOURS=
ALELT_LEASE_TTL_S=30

# --- console auth (OIDC) --------------------------------------------------------------------------------------
ALELT_OIDC_ISSUER=
ALELT_OIDC_AUDIENCE=
ALELT_OIDC_JWKS_URL=

# --- LB -------------------------------------------------------------------------------------------------------
# CIDR(s) of the LB / proxy allowed to set X-Forwarded-* ('*' refused in prod)
ALELT_FORWARDED_ALLOW_IPS=10.0.0.0/24
