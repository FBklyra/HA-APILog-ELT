# /etc/alelt/agent.env - environment of alelt.service (root:alelt 0640). Secrets live here, never in aleltagent.json.
# Edit, then: systemctl restart alelt

# Hub agent token (hub.mode = token | dev). Not needed with hub.mode = mtls (client certificate files).
ALELT_AGENT_TOKEN=

# Source credentials (names referenced by source.user_env / source.password_env in aleltagent.json).
# Alternative for passwords: source.password_file + systemd LoadCredential= in a drop-in.
#ALELT_SOURCE_USER=
#ALELT_SOURCE_PASSWORD=

# Db2 client (engine db2): instance owner's sqllib; also list <sqllib>/lib64 in source.dll_dirs.
#DB2INSTANCE=db2inst1
#DB2_HOME=/home/db2inst1/sqllib

# Optional connector registry override (same format as the hub's ALELT_SOURCES)
#ALELT_SOURCES={"postgres": "alelt_src_postgres.connector:PostgresSource"}
