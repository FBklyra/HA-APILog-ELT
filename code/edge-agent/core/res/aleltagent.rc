#include <winver.h>
#include "../src/agent/version.h"

// Event Log message table generated by mc.exe from aleltagent_msg.mc
#include "aleltagent_msg.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ALELT_AGENT_VERSION_RC
 PRODUCTVERSION ALELT_AGENT_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Freddy Beltran"
            VALUE "FileDescription", "ALELT edge agent"
            VALUE "FileVersion", ALELT_AGENT_VERSION
            VALUE "InternalName", "aleltagent"
            VALUE "LegalCopyright", "Copyright (c) Freddy Beltran. Apache-2.0"
            VALUE "OriginalFilename", "aleltagent.exe"
            VALUE "ProductName", "ALELT"
            VALUE "ProductVersion", ALELT_AGENT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
