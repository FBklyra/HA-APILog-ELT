# /etc/alelt/hub.env - environment of alelt-hub / alelt-worker@N / alelt-capture (root:alelt 0640).
# Same variables as the container image (deploy/hub/README.md). Secrets may be given as ALELT_<NAME>_FILE=/path.
ALELT_ENV=prod
ALELT_DEV_AUTH=0
# Secrets as files, never inline here (R9 / DEP-21): root:alelt 0640 files under /etc/alelt/credentials/
#   install -d -m 0750 -o root -g alelt /etc/alelt/credentials
#   printf %s 'postgresql+psycopg://alelt:...@db.example.internal:5432/alelt' > /etc/alelt/credentials/alelt_db_url
ALELT_DB_URL_FILE=/etc/alelt/credentials/alelt_db_url
#ALELT_DEST_URL_FILE=/etc/alelt/credentials/alelt_dest_url
# agents: enrolment tokens (console Setup) -> per-agent credentials. Static ALELT_AGENT_TOKENS are refused when
# ALELT_ENV=prod. mTLS: ALELT_AGENT_AUTH=mtls + ALELT_TRUSTED_PROXIES=<TLS proxy address> (never '*').
ALELT_AGENT_AUTH=enrollment
ALELT_PUBLIC_URL=https://alelt.example.internal
# reverse proxy on this host: X-Forwarded-For trusted only from it
ALELT_FORWARDED_ALLOW_IPS=127.0.0.1
# DBA-owned archive-log retention in hours (archive-horizon alert, X-129)
ALELT_ARCHIVE_RETENTION_HOURS=
ALELT_SPOOL_DIR=/var/lib/alelt/hub-spool
ALELT_HOST=0.0.0.0
ALELT_PORT=8080
ALELT_LOG_LEVEL=INFO
ALELT_DB2_DECODER=python
# console (static SPA): build console/ once (npm ci && npm run build) and point here, or leave unset (API only)
#ALELT_CONSOLE_DIR=/opt/alelt/app/console/dist
#ALELT_OIDC_ISSUER=
#ALELT_OIDC_AUDIENCE=
#ALELT_OIDC_JWKS_URL=
