# Console build-time settings (no secrets: client id/tenant id are public identifiers)
# 1 = in-browser mock API (no hub needed); 0 = call the hub /api/v1
VITE_ALELT_MOCK=1
# 1 = dev auth: role picker, sends X-ALELT-Dev-Role (hub accepts only when ALELT_DEV_AUTH=1, never in prod)
VITE_ALELT_DEV_AUTH=1
VITE_ALELT_API_BASE=/api/v1
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://alelt-hub/Console.Access
